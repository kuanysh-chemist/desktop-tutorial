{
  "name": "ksp-generator-chemistry",
  "version": "0.1.0",
  "private": true,
  "description": "Генератор краткосрочных планов (КСП) по химии для учителей Казахстана — RU/KZ, экспорт в DOCX и PDF",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:match": "tsx scripts/verify-match.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "verify:coverage": "tsx scripts/verify-coverage.ts",
    "verify": "npm run typecheck && npm run lint && npm run verify:coverage && npm run verify:match && npm run verify:claude",
    "verify:claude": "tsx --conditions react-server scripts/verify-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "docx": "^9.7.1",
    "next": "15.5.25",
    "pdfmake": "^0.2.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
